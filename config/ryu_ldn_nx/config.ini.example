; ryu_ldn_nx Configuration
; Auto-generated on first boot
; Edit this file to customize settings

[server]
; Server hostname or IP address
host = 90.93.156.13
; Server port
port = 30456

[ldn]
; Enable LDN emulation (0/1/true/false/yes/no)
enabled = 1
; Enable passphrase filtering (0/1)
use_passphrase = 0
; Room passphrase (empty = public)
passphrase =
; Disable P2P proxy (0 = false | 1 = true) : DO NOT SET at 0 / false (P2P is not fully implemented and in development)
disable_p2p = 1

[debug]
; Enable debug logging (0/1/true/false/yes/no)
; When enabled, logs are written to both console and SD card file.
enabled = 0
; Log level (0=errors, 1=warnings, 2=info, 3=verbose)
level = 1
